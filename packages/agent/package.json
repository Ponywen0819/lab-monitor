{
  "name": "@labmon/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile ./dist-bin/agent-linux-x64 && bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile ./dist-bin/agent-linux-arm64",
    "dev": "LABMON_AGENT_CONFIG=dev-config.json tsx src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@labmon/shared": "*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "vitest": "^2.1.9"
  }
}
