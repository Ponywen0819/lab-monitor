# Copy this file to .env and fill in real values. .env is gitignored.
#
# Used two ways: (1) `docker compose` reads it automatically to substitute
# ${VITE_HTTP_BASE_URL} / ${VITE_WS_URL} in docker-compose.yml at build
# time, and (2) it's passed to the collector container via env_file.

# --- Collector <-> outside world -------------------------------------
# Must be the lab server's real LAN IP (or hostname), NOT localhost --
# this is written into every newly-installed agent's config.json so it
# knows where to connect back, and burned into the frontend's static
# bundle at build time so browsers on other machines can reach it.
COLLECTOR_WS_URL=ws://<lab-server-lan-ip>:8080
VITE_HTTP_BASE_URL=http://<lab-server-lan-ip>:8081
VITE_WS_URL=ws://<lab-server-lan-ip>:8080

# --- Email notifications (dedicated Gmail account, not a personal one) -
# smtp.gmail.com requires an App Password, not the account login password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Rarely need changing (defaults already match docker-compose.yml) --
# WS_PORT=8080
# HTTP_PORT=8081
# DB_PATH=./data/collector.db

# --- Host path for the collector's persistent data (SQLite DB) ---------
# Bind-mounted into the container at /app/data, so it survives image
# rebuilds/updates regardless of where this points. Only used by
# docker-compose.yml (not read by the app itself). Absolute path
# recommended if you run `docker compose` from outside the repo dir.
# DATA_DIR=./data
